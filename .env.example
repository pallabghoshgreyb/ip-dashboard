# Copy this file to .env and fill in real values. Never commit the real .env file.

# Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ip_dashboard

# Set to "true" if your Postgres provider requires SSL (most managed/cloud providers do).
PGSSL=false

# Port the app listens on.
PORT=3000

# Credentials for the /admin upload page. CHANGE THESE before deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_TO_SOMETHING_STRONG
